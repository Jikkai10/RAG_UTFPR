# --- API do RAG (usada pelo evaluate.py para gerar as respostas) ---
RAG_API_URL=http://localhost:8080
EVAL_EMAIL=admin@email.com
EVAL_PASSWORD=senha

# --- LLM juiz das métricas do ragas ---
JUDGE_API_KEY=<YOUR_JUDGE_API_KEY>
JUDGE_BASE_URL=https://ollama.com/v1
JUDGE_MODEL=gpt-oss:120b

# Modelo de embedding usado pela métrica answer_relevancy
EVAL_EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base

# --- Avaliação ---
# "all" avalia tudo que o retriever trouxe, "cited" só o que a resposta citou
EVAL_CONTEXT_SOURCE=all
# Chamadas simultâneas ao LLM juiz
EVAL_CONCURRENCY=2

# --- Serviços ---
OLLAMA_URL=http://localhost:11434
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

NEO4J_PASSWORD=12345678

JWT_SECRET=dev-secret-change-me